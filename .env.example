# ---- Compte administrateur (créé ou mis à jour à chaque démarrage) ----
# Identifiant de connexion : une adresse e-mail (ou « admin » par défaut)
ADMIN_EMAIL=admin@exemple.fr
ADMIN_PASSWORD=change-moi
ADMIN_NAME=Administrateur

# Secret de signature des sessions (facultatif : généré et stocké en base sinon)
SESSION_SECRET=

# ---- Dépôt Git des diagrammes ----
# Sans GIT_REMOTE_URL, le dépôt reste local (dans DATA_DIR/repo), avec tout l'historique.
# Avec, il est cloné au premier démarrage, récupéré toutes les GIT_SYNC_INTERVAL secondes,
# et chaque enregistrement est poussé. Exemples :
#   https://x-access-token:<jeton>@github.com/organisation/diagrammes.git   (jeton fine-grained, droit Contents: read & write)
#   https://oauth2:<jeton>@gitlab.com/groupe/diagrammes.git
GIT_REMOTE_URL=
GIT_BRANCH=main
GIT_SUBDIR=diagrams
GIT_SYNC_INTERVAL=300


# ---- Divers ----
# PORT=3000
# DATA_DIR=./data            (base SQLite + dépôt Git ; /data dans l'image Docker)
# COOKIE_SECURE=auto         (Secure seulement en HTTPS ; true/false pour forcer)
# TRUST_PROXY=true
# PUBLIC_URL=https://bpmn.exemple.fr   (adresse publique, utilisée par le connecteur Claude)
# LOG_LEVEL=warn
