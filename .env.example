# Mot de passe de l'administrateur (obligatoire pour gérer les diagrammes et les liens de partage)
ADMIN_PASSWORD=change-moi

# Secret de signature des sessions (facultatif : généré et stocké en base sinon)
SESSION_SECRET=

# Assistant IA (facultatif : sans clé, l'onglet Assistant indique qu'il n'est pas configuré)
# LLM_PROVIDER=anthropic → API Anthropic Messages (LLM_MODEL par défaut : claude-sonnet-5-5)
# LLM_PROVIDER=openai    → toute API compatible OpenAI /chat/completions (OpenAI, LiteLLM, Scaleway, Mistral, vLLM…)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
AI_RATE_LIMIT_PER_HOUR=40

# Divers
# PORT=3000
# DATABASE_FILE=./data/bpmn.sqlite
# COOKIE_SECURE=auto   (par défaut : attribut Secure seulement si le site est servi en HTTPS ; true/false pour forcer)
# LOG_LEVEL=warn   (info pour journaliser chaque requête)
