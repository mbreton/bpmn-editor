{
  "name": "bpmn-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Éditeur BPMN collaboratif auto-hébergé : édition, assistant IA, centre d'aide, simulation pas à pas, liens de partage.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test server/test/*.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "bpmn-moddle": "^10.3.1",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@bpmn-io/diagram-js-canvas-lock": "^0.1.0",
    "bpmn-auto-layout": "^1.3.0",
    "bpmn-js": "^18.33.1",
    "bpmn-js-token-simulation": "^1.1.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
